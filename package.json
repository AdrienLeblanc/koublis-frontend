{
  "name": "koublis-frontend",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "pnpm run write:env -s && ng serve --proxy-config proxy.conf.js",
    "build": "pnpm run write:env -s && ng build",
    "test": "pnpm run write:env -s && ng test",
    "write:env": "ngx-scripts env npm_package_version"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "20.0.1",
    "@angular/common": "^20.0.0",
    "@angular/compiler": "^20.0.0",
    "@angular/core": "^20.0.0",
    "@angular/forms": "^20.0.0",
    "@angular/material": "20.0.1",
    "@angular/platform-browser": "^20.0.0",
    "@angular/platform-browser-dynamic": "^20.0.0",
    "@angular/router": "^20.0.0",
    "@koublis/api-client": "1.0.1",
    "@ngx-rocket/scripts": "^5.2.3",
    "@ngx-translate/core": "^16.0.4",
    "@biesbjerg/ngx-translate-extract": "^7.0.4",
    "@biesbjerg/ngx-translate-extract-marker": "^1.0.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^20.0.0",
    "@angular/cli": "^20.0.0",
    "@angular/compiler-cli": "^20.0.0",
    "@types/jasmine": "~5.1.8",
    "jasmine-core": "~5.7.1",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "prettier": "3.5.3",
    "typescript": "~5.8.3"
  }
